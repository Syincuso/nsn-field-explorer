{
  "manifest_version": 3,
  "name": "NSN Field Explorer",
  "version": "0.25.3",
  "description": "Read-only field IDs, labels, types, values and sublist lines for NetSuite records, including NetSuite Next. Opens with Alt+Shift+F.",
  "homepage_url": "https://syincuso.com/?utm_source=nsn-field-explorer&utm_medium=extension&utm_content=store",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "nsn-field-explorer@syincuso.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "NSN Field Explorer (NetSuite Next)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle the NSN Field Explorer panel"
    }
  }
}
